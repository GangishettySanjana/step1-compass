# Database — added automatically when you attach a free Neon Postgres
# database from the Vercel project's Storage tab. You shouldn't need to set
# this by hand on Vercel; for local dev, copy the value Vercel shows you.
DATABASE_URL=

# Free-tier LLM calls (daily intention + weekly quiz). Get a free key at
# https://openrouter.ai/keys — no payment method needed for ":free" models.
OPENROUTER_API_KEY=

# Reminder emails. Free tier (100/day) at https://resend.com — no card needed.
RESEND_API_KEY=
# Optional: a custom "from" address once you verify a domain in Resend.
# Defaults to Resend's shared onboarding address if left unset.
REMINDER_FROM_EMAIL=
# Comma-separated list of the 3 people who should get reminder emails.
REMINDER_EMAILS=

# Browser push notifications (self-hosted, free). Generate once with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Same public key, exposed to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# A random string you invent — protects /api/cron/reminders from strangers.
# The free external cron job (e.g. cron-job.org) must send this as ?secret=
CRON_SECRET=
